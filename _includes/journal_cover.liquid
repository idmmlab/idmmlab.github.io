{% if include.paper.journal and include.paper.preview and include.paper.preview != blank %}
  {% unless include.paper.preview contains '://' %}
    <img
      class="journal-cover"
      src="{{ include.paper.preview | prepend: '/assets/img/publication_preview/' | relative_url }}"
      alt="{{ include.paper.journal | escape }} journal cover"
      width="40"
      height="54"
      loading="lazy"
      decoding="async"
    >
  {% endunless %}
{% endif %}
