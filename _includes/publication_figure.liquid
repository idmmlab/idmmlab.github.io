{% assign paper_figure = site.data.publication_figures[include.key] %}
{% if paper_figure %}
  {% assign figure_file = include.key | append: '.webp' %}
  {% include publication_figure_item.liquid asset=paper_figure fallback_file=figure_file %}
  {% if paper_figure.additional %}
    {% include publication_figure_item.liquid asset=paper_figure.additional %}
  {% endif %}
{% endif %}
