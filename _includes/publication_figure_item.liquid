{% assign figure_path = include.asset.file | default: include.fallback_file | prepend: '/assets/img/publication_preview/' | relative_url %}
<figure class="publication-figure">
  <a href="{{ figure_path }}" aria-label="Open {{ include.asset.alt | escape }} at full size">
    <img
      src="{{ figure_path }}"
      alt="{{ include.asset.alt | escape }}"
      {% if include.asset.width and include.asset.height %}
        class="publication-figure-native"
        width="{{ include.asset.width }}"
        height="{{ include.asset.height }}"
      {% endif %}
      loading="lazy"
      decoding="async"
    >
  </a>
  <figcaption>
    {% if include.asset.label %}{{ include.asset.label | escape }} · {% endif %}
    <a href="{{ include.asset.source }}">{{ include.asset.credit | escape }}</a>
    {% if include.asset.license %}
      · <a href="https://creativecommons.org/licenses/{{ include.asset.license }}/4.0/">{{ include.asset.license | upcase | prepend: 'CC ' }} 4.0</a>
    {% endif %}
  </figcaption>
</figure>
